# Copie este arquivo para .env e preencha os valores.
# O .env real nunca deve ser commitado.

# PostgreSQL local via Docker (docker compose up -d na raiz do projeto).
# Em producao, use a URL fornecida pela plataforma de deploy.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/controle_financeiro?schema=public"

# Segredo usado para assinar os tokens JWT.
# Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-valor-aleatorio-longo"

# Tempo de validade do token (ex: 15m, 1h, 1d, 7d)
JWT_EXPIRES_IN="1d"

# Origens autorizadas a chamar a API (separadas por virgula).
CORS_ORIGIN="http://localhost:5173"
